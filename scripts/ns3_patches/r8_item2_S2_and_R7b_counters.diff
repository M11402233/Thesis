+// ---- R-7 item 2 (S2, 2026-11-13; docs/thesis/report_semantics_spec_v0.md §5.8) ----
+// ZT_R7_S2=1：轉送前只保留第一個 PdcpTag（原始 PDCP 起點），清除其餘所有 byte tag（含舊 RlcTag）。
+// 未設定（預設）＝原版行為（S0），不改任何輸出。
+static bool
+R7S2Enabled()
+{
+    static const bool on = [] {
+        const char* e = std::getenv("ZT_R7_S2");
+        return e != nullptr && std::string(e) == "1";
+    }();
+    return on;
+}
+
+static void
+R7S2StripForwardedByteTags(Ptr<Packet> p)
+{
+    if (!R7S2Enabled())
+    {
+        return;
+    }
+    PdcpTag first;
+    bool has = p->FindFirstMatchingByteTag(first);
+    p->RemoveAllByteTags();
+    if (has)
+    {
+        p->AddByteTag(first);
+    }
+}
