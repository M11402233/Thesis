<mxfile host="app.diagrams.net">
  <diagram name="fusion step" id="fusion-step-4-4-0">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 起點 -->
        <mxCell id="start" value="&lt;b&gt;Evidence for this&lt;br&gt;(node, window)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="10" width="180" height="56" as="geometry"/>
        </mxCell>

        <!-- LEVEL 1 -->
        <mxCell id="L1box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="100" width="1220" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="L1lbl" value="&lt;b&gt;LEVEL 1 — hard violation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="22" y="110" width="290" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;Hard violation ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rej1" value="&lt;b&gt;✗ REJECTED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;exclude — this KPM is not relied on&lt;br&gt;R1_CI_VETO · R1_D2_VETO · R1_STAGE1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="250" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="lt1" value="&lt;b&gt;! LOW-TRUST&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;restrict — R1_CI_PENDING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;→ REJECTED&lt;/b&gt; if any of:&lt;br&gt;• C_i violated (N_total ≠ N_known) for ≥ L_C (= 2) consecutive windows&lt;br&gt;• H_i-D2 teleport (mmWave A → mmWave B without LTE anchor)&lt;br&gt;• Stage-1 identity precondition fails&lt;br&gt;&lt;b&gt;→ LOW-TRUST&lt;/b&gt; if C_i violated but run &amp;lt; L_C windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="140" width="420" height="110" as="geometry"/>
        </mxCell>

        <!-- LEVEL 2 -->
        <mxCell id="L2box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="345" width="1220" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="L2lbl" value="&lt;b&gt;LEVEL 2 — statistical evidence&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="22" y="355" width="290" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Statistical evidence ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="520" y="385" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rej2" value="&lt;b&gt;✗ REJECTED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;exclude — R2_SI_D1_BOUND&lt;br&gt;(S_i and D1 point to the same node)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="250" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="lt2" value="&lt;b&gt;! LOW-TRUST&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;restrict — R2_SI_D1_UNBOUND · R2_SI_ALONE&lt;br&gt;R2_D1_STRONG · R2_D1_WEAK&lt;br&gt;no multi-window escalation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="250" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="• S_i: |delay_j − peer median| / s &amp;gt; τ_S (= 4)&lt;br&gt;• H_i-D1: dwell robust z ≥ τ_H^warn (= 2); strong if ≥ τ_H^reject (= 3)&lt;br&gt;&amp;nbsp;&amp;nbsp;attributed to the UE's last serving mmWave cell (uebound)&lt;br&gt;&lt;b&gt;→ REJECTED&lt;/b&gt; only if S_i violated AND D1 strong AND same node&lt;br&gt;&lt;b&gt;→ LOW-TRUST&lt;/b&gt; otherwise (single statistical evidence never vetoes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="385" width="420" height="110" as="geometry"/>
        </mxCell>

        <!-- LEVEL 3 -->
        <mxCell id="L3box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="590" width="1220" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="L3lbl" value="&lt;b&gt;LEVEL 3 — evidence availability (checked LAST, not first)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="22" y="600" width="420" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Evidence applicable ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="520" y="630" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="tr" value="&lt;b&gt;✓ TRUSTED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;allow — R0_CLEAN&lt;br&gt;no counterexample found (not proven true)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="250" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;→ ABSTAIN&lt;/b&gt; if any of:&lt;br&gt;• S_i peers &amp;lt; MIN_PEER (= 2)&lt;br&gt;• LTE anchor report missing&lt;br&gt;• window not aligned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="640" width="420" height="80" as="geometry"/>
        </mxCell>

        <!-- 終點 ABSTAIN -->
        <mxCell id="ab" value="&lt;b&gt;? ABSTAIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;defer — R3_ABSTAIN&lt;br&gt;never treated as trusted (fail-closed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="495" y="800" width="250" height="66" as="geometry"/>
        </mxCell>

        <!-- 底部註記 -->
        <mxCell id="foot" value="Rules are evaluated in order L1 → L2 → L3 → L0; the first match decides. No inheritance: every (node, window) is re-judged.&lt;br&gt;Severity: trusted ≺ abstain ≺ low-trust ≺ rejected.  &lt;b&gt;rejected&lt;/b&gt; means this KPM is not relied on — it does &lt;b&gt;not&lt;/b&gt; mean the node is an attacker.&lt;br&gt;Authoritative definition: thesis §4.4.0." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="20" y="885" width="1200" height="60" as="geometry"/>
        </mxCell>

        <!-- 主線 -->
        <mxCell id="e0" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="start" target="d1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="no" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="no" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="no" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3" target="ab">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 分支 -->
        <mxCell id="b1a" value="yes — veto" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d1" target="rej1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b1b" value="yes — C_i run &amp;lt; L_C" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.25;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="d1" target="lt1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b2a" value="yes — bound to same node" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d2" target="rej2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b2b" value="yes — otherwise" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="d2" target="lt2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="yes" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d3" target="tr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 說明框虛線連結 -->
        <mxCell id="c1" style="endArrow=none;html=1;dashed=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="n1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c2" style="endArrow=none;html=1;dashed=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="n2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c3" style="endArrow=none;html=1;dashed=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="n3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
